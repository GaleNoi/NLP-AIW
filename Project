# funzione che restituisce le 10 parole più comuni
def top_10_parole():
   parole_comuni = {}
   for token in Alice_Testo_Pulito:
       if not token.is_space and not token.is_stop and not token.is_punct:
           lemma = token.lemma_.lower()
           parole_comuni.setdefault(lemma, 0)
           parole_comuni[lemma] +=  1
   return(parole_comuni)






# funzione che stampa le 10 parole più comuni
def top_10_parole_stampa():
   top10parole = Counter(top_10_parole()).most_common(5)
   for index,i in enumerate(top10parole):
       print(f" la {index+1}° parola più frequente  è '{i[0]}' ripetuta: {i[1]} volte")


# print(top_10_parole_stampa())
